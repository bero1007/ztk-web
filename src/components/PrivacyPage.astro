---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import type{Lang}from '@/data/content';import{routes}from '@/lib/i18n';
const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';const r=routes(lang);
---
<BaseLayout {lang} title={hr?'Privatnost — ZTK':'Privacy — ZTK'} description={hr?'Informacije o privatnosti na web-stranici ZTK.':'Privacy information for the ZTK website.'} canonicalPath={r.privacy} alternatePath={hr?'/en/privacy/':'/privatnost/'}>
 <Hero eyebrow={hr?'Privatnost':'Privacy'} title={hr?'Jednostavno i <em>bez praćenja.</em>':'Simple and <em>tracker-free.</em>'} description={hr?'Prototip ne koristi marketinške trackere ni kolačiće za oglašavanje.':'This prototype uses no marketing trackers or advertising cookies.'} compact />
 <section class="section"><div class="container privacy"><h2>{hr?'Koje podatke obrađujemo':'What data we process'}</h2><p>{hr?'Ako koristite booking ili skladateljski obrazac bez povezanog endpointa, podaci ostaju u vašem pregledniku i prenose se u vašu aplikaciju za e-poštu. Ako se kasnije poveže backend, ova stranica bit će ažurirana prije javne objave.':'When you use the booking or composer form without a connected endpoint, the data remains in your browser and is transferred to your email application. If a backend is connected later, this page will be updated before public launch.'}</p><h2>{hr?'Vanjske usluge':'External services'}</h2><p>{hr?'Karta koristi OpenStreetMap pločice. Vanjske medijske poveznice otvaraju YouTube, Instagram, Facebook ili Apple Music tek nakon vašeg klika.':'The map uses OpenStreetMap tiles. External media links open YouTube, Instagram, Facebook or Apple Music only after your click.'}</p><h2>{hr?'Kontakt':'Contact'}</h2><p><a href="mailto:zagreb.tambura.quartet@gmail.com">zagreb.tambura.quartet@gmail.com</a></p></div></section>
</BaseLayout>
<style>.privacy{max-width:800px;display:grid;gap:20px}.privacy h2{font-size:2.5rem;margin-top:25px}.privacy p{font-size:1.05rem}</style>
