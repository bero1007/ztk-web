---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import type{Lang}from '@/data/content';import{routes}from '@/lib/i18n';
const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';const r=routes(lang);
---
<BaseLayout {lang} title={hr?'Privatnost — ZTK':'Privacy — ZTK'} description={hr?'Informacije o privatnosti na web-stranici ZTK.':'Privacy information for the ZTK website.'} canonicalPath={r.privacy} alternatePath={hr?'/en/privacy/':'/privatnost/'}>
 <Hero eyebrow={hr?'Privatnost':'Privacy'} title={hr?'Jednostavno i <em>bez praćenja.</em>':'Simple and <em>tracker-free.</em>'} description={hr?'Ova stranica ne koristi marketinške trackere ni kolačiće za oglašavanje.':'This website uses no marketing trackers or advertising cookies.'} compact />
 <section class="section"><div class="container privacy"><h2>{hr?'Tko obrađuje podatke':'Who processes your data'}</h2><p>Pećarić – glazbeni projekti, obrt za usluge i poduku, vl. Franjo Pećarić, Otočka ulica 5A, Vinkovci, Hrvatska.</p>
<h2>{hr?'Koncertni upiti i skladbe':'Concert enquiries and compositions'}</h2><p>{hr?'Podatke koje nam pošaljete (ime, kontakt i sadržaj poruke) koristimo za odgovor na vaš upit i dogovor o suradnji. Obrada se temelji na poduzimanju radnji na vaš zahtjev prije sklapanja ugovora ili našem legitimnom interesu da odgovorimo na ostale poruke. Obrasci pripremaju poruku u vašoj aplikaciji za e-poštu; upit nam stiže tek kada ga ondje pošaljete.':'We use the details you send (name, contact details and message) to respond and discuss collaboration. Processing is based on steps taken at your request before entering a contract, or our legitimate interest in responding to other correspondence. Forms prepare a message in your email application; we receive it only when you send it there.'}</p>
<h2>{hr?'Čuvanje i vaša prava':'Retention and your rights'}</h2><p>{hr?'Korespondenciju čuvamo koliko je potrebno za upit i suradnju, odnosno koliko nalažu zakonske obveze za povezanu dokumentaciju. Možete zatražiti pristup, ispravak, brisanje ili ograničenje obrade, uložiti prigovor te, kada su ispunjeni uvjeti, zatražiti prenosivost podataka. Zahtjev pošaljite na kontakt ispod.':'We keep correspondence as needed for the enquiry and collaboration, or as legally required for related records. You may request access, correction, deletion or restriction, object to processing and, where applicable, request data portability. Use the contact below.'}</p><p><a href="https://azop.hr/">{hr?'Agencija za zaštitu osobnih podataka – pravo na pritužbu':'Croatian Personal Data Protection Agency – right to complain'}</a></p>
<h2>{hr?'Vanjske usluge':'External services'}</h2><p>{hr?'Stranicu poslužuje GitHub Pages, koji može obrađivati tehničke podatke poput IP adrese radi isporuke i sigurnosti usluge. Fontovi se poslužuju zajedno s ovom stranicom, bez povezivanja s Google Fonts. Karta se povezuje s OpenStreetMapom tek nakon klika na „Učitaj kartu”; pružatelju se tada šalju tehnički podaci potrebni za prikaz. Vanjske medijske poveznice otvaraju odabrani servis tek nakon vašeg klika.':'GitHub Pages hosts this website and may process technical data such as IP addresses for delivery and security. Fonts are hosted with this website, without a connection to Google Fonts. The map connects to OpenStreetMap only after you click “Load map”, sending the technical data needed to display it. External media links open the selected service only after your click.'}</p><p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub</a> · <a href="https://osmfoundation.org/wiki/Privacy_Policy">OpenStreetMap</a></p>
<h2>{hr?'Kontakt':'Contact'}</h2><p><a href="mailto:zagreb.tambura.quartet@gmail.com">zagreb.tambura.quartet@gmail.com</a></p></div></section>
</BaseLayout>
<style>.privacy{max-width:800px;display:grid;gap:20px}.privacy h2{font-size:2.5rem;margin-top:25px}.privacy p{font-size:1.05rem}</style>
