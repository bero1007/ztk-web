---
import type { Lang } from '@/data/content';
import { labels, routes, path } from '@/lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const r = routes(lang); const l = labels[lang];
---
<footer>
  <div class="container footer-grid">
    <div class="stack"><div class="footer-brand"><span class="footer-logo-window"><img class="footer-logo" src={path('/images/brand/logo-light.svg')} alt="Zagreb Tambura Quartet" /></span></div><h2>{lang === 'hr' ? 'Tradicija u suvremenom izrazu.' : 'Tradition in a contemporary voice.'}</h2></div>
    <div class="footer-links">
      <a href={path(r.booking)}>zagreb.tambura.quartet@gmail.com</a>
      <a href={path(r.privacy)}>{l.privacy}</a>
      <p>© {new Date().getFullYear()} Zagreb Tambura Quartet</p>
    </div>
  </div>
</footer>
<style>
  footer { position:relative;padding: 92px 0 38px; overflow:hidden;background: #0c1b2b; color: white; border-top:1px solid rgba(231,235,233,.12); }
  footer::before{content:'';position:absolute;inset:0 0 auto;height:4px;background:linear-gradient(90deg,var(--color-copper) 0 11%,transparent 11% 14%,var(--color-moss-500) 14% 38%,transparent 38%)}
  .footer-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 50px; align-items: end; }
  h2 { max-width: 700px; font-size: clamp(2.4rem, 5vw, 5rem); }
  .footer-brand{display:flex;align-items:center}.footer-logo-window{display:block;width:88px;height:127px}.footer-logo{width:100%;height:100%;object-fit:contain}
  .footer-links { display: grid; gap: 12px; justify-items: end; text-align: right; color: #bdc6c4; font-size: .82rem; }
  .footer-links a { text-underline-offset: 4px; }
  @media (max-width: 700px) { .footer-grid { grid-template-columns: 1fr; } .footer-links { justify-items: start; text-align: left; } }
</style>
