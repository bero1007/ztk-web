---
import type { Lang } from '@/data/content';
import { routes, path } from '@/lib/i18n';
const { lang } = Astro.props as {lang:Lang}; const hr=lang==='hr'; const r=routes(lang);
---
<footer>
 <div class="container footer-grid">
  <a href={path(r.home)} aria-label={hr?'Zagrebački tamburaški kvartet — početna':'Zagreb Tambura Quartet — home'}><img class="footer-logo" src={path('/images/brand/logo-original.png')} alt={hr?'Zagrebački tamburaški kvartet':'Zagreb Tambura Quartet'} width="3188" height="3188" loading="lazy" /></a>
  <div class="footer-contact"><p class="eyebrow">{hr?'Producent':'Producer'}</p><p>Josip Berend</p><a href="tel:+385994074710">+385 99 407 4710</a><a href="mailto:zagreb.tambura.quartet@gmail.com">zagreb.tambura.quartet@gmail.com</a></div>
  <div class="footer-meta"><a href={path(r.privacy)}>{hr?'Privatnost':'Privacy'}</a><p>© Zagreb Tambura Quartet, 2026.</p></div>
 </div>
</footer>
<style>
footer{padding:40px 0;background:var(--color-navy-950);color:var(--color-paper)}
.footer-grid{display:grid;grid-template-columns:180px 1fr auto;gap:40px;align-items:center}
.footer-logo{width:180px;height:180px;object-fit:contain}.footer-contact,.footer-meta{display:grid;gap:8px;font-size:.84rem}.footer-meta{align-self:end;color:var(--color-silver)}a{overflow-wrap:anywhere;text-underline-offset:4px}
@media(max-width:760px){.footer-grid{grid-template-columns:1fr;gap:24px}.footer-logo{width:150px;height:150px}.footer-meta{padding-top:20px;border-top:1px solid var(--color-line)}}
</style>
