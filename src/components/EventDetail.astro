---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import EventsMap from '@/components/EventsMap.astro';import{members,programmes,repertoire}from '@/data/content';import type{EventItem,Lang}from '@/data/content';import{formatDate}from '@/lib/i18n';
const {lang,event}=Astro.props as{lang:Lang;event:EventItem};const hr=lang==='hr';const works=event.repertoireIds.map(id=>repertoire.find(w=>w.id===id)).filter(Boolean);const programme=programmes.find(p=>p.id===event.programme);
const canonicalPath=hr?`/dogadjaji/${event.slug}/`:`/en/events/${event.slug}/`;const alternatePath=hr?`/en/events/${event.slug}/`:`/dogadjaji/${event.slug}/`;
const schema={'@context':'https://schema.org','@type':'MusicEvent',name:hr?event.titleHr:event.titleEn,startDate:`${event.date}T${event.time}:00+02:00`,location:{'@type':'Place',name:event.venue,address:{'@type':'PostalAddress',streetAddress:event.address,addressLocality:event.city,addressCountry:'HR'}},performer:{'@type':'MusicGroup',name:'Zagreb Tambura Quartet'}};
---
<BaseLayout {lang} title={`${hr?event.titleHr:event.titleEn} — ZTK`} description={`${formatDate(event.date,lang)}, ${event.venue}, ${event.city}.`} {canonicalPath} {alternatePath} {schema}>
 <Hero eyebrow={`${formatDate(event.date,lang)} · ${event.time}`} title={hr?event.titleHr:event.titleEn} description={`${event.venue} · ${event.address}, ${event.city}`} compact />
 <section class="section"><div class="container"><nav class="tabs" aria-label={hr?'Sadržaj događaja':'Event content'}><a href="#program">{hr?'Program':'Programme'}</a><a href="#works">{hr?'O djelima':'About the works'}</a><a href="#performers">{hr?'Izvođači':'Performers'}</a><a href="#location">{hr?'Lokacija':'Location'}</a><a href="#media">{hr?'Mediji':'Media'}</a></nav>
 <article class="digital card" id="program"><div><p class="eyebrow">{hr?'Digitalni koncertni program':'Digital concert programme'}</p><h2>{programme&&(hr?programme.titleHr:programme.titleEn)}</h2><p class="lead">{formatDate(event.date,lang)} · {event.time}<br>{event.venue}</p></div><ol>{works.map(work=><li><span>{work?.composer}</span><a href={`#work-${work?.id}`}><i>{work?.title}</i></a></li>)}</ol></article></div></section>
 <section class="section alt" id="works"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'O djelima':'About the works'}</p><h2>{hr?'Program, bez dupliciranja podataka.':'One programme, one source of truth.'}</h2></div><div class="works">{works.map(work=><article id={`work-${work?.id}`} class="work"><p class="eyebrow">{work?.composer}</p><h3><i>{work?.title}</i></h3>{(hr?work?.descriptionHr:work?.descriptionEn)?<p>{hr?work?.descriptionHr:work?.descriptionEn}</p>:<p class="empty-note">{hr?'Opis djela čeka autorizirani sadržaj.':'Work note awaits approved copy.'}</p>}{work?.videoUrls.map(url=><a class="text-link" href={url} target="_blank" rel="noreferrer">Video <span>↗</span></a>)}</article>)}</div></div></section>
 <section class="section" id="performers"><div class="container grid-2"><div class="section-head"><p class="eyebrow">{hr?'Izvođači':'Performers'}</p><h2>Zagreb Tambura Quartet</h2></div><div class="stack"><ul class="performers">{members.map(member=><li><strong>{member.name}</strong><span>{member.instrument[lang]}</span></li>)}</ul>{event.moderator&&<p><strong>{hr?'Moderatorica':'Moderator'}:</strong> {event.moderator}</p>}</div></div></section>
 <section class="section alt" id="location"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Lokacija':'Location'}</p><h2>{event.venue}</h2><p class="lead">{event.address}, {event.city}, {event.country}</p></div><EventsMap events={[event]} {lang}/></div></section>
 <section class="section" id="media"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Mediji':'Media'}</p><h2>{hr?'Nakon koncerta':'After the concert'}</h2><p class="lead">{hr?'Fotografije i videozapisi mogu se dodati na isti URL nakon događaja.':'Photos and videos can be added to this same URL after the event.'}</p></div></div></section>
</BaseLayout>
<style>.tabs{display:flex;gap:10px;overflow:auto;margin-bottom:40px;padding-bottom:8px}.tabs a{white-space:nowrap;text-decoration:none;background:white;border:1px solid var(--color-line);border-radius:999px;padding:.75rem 1rem;font-size:.78rem;font-weight:700}.tabs a:hover{border-color:var(--color-copper)}.digital{padding:clamp(28px,6vw,72px);display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.digital ol{margin:0;padding:0;list-style:none}.digital li{display:grid;gap:3px;padding:16px 0;border-bottom:1px solid var(--color-line)}.digital li span{font-size:.76rem;text-transform:uppercase;letter-spacing:.07em}.digital li a{font:500 1.4rem var(--serif);text-decoration-color:var(--color-copper)}.works{display:grid;gap:0;border-top:1px solid var(--color-line)}.work{display:grid;grid-template-columns:.7fr 1fr 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--color-line)}.work .text-link{justify-self:end}.performers{list-style:none;margin:0;padding:0}.performers li{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid var(--color-line)}.performers span{color:var(--color-muted)}@media(max-width:750px){.digital,.work{grid-template-columns:1fr;gap:24px}.work .text-link{justify-self:start}}</style>
