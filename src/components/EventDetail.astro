---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import EventsMap from '@/components/EventsMap.astro';import{members,programmes,publishedWorksByIds,workTitle,workVideos}from '@/data/content';import type{EventItem,Lang}from '@/data/content';import{countryLabel,formatDate,path}from '@/lib/i18n';
import{performancePlaces}from '@/data/places';
const {lang,event}=Astro.props as{lang:Lang;event:EventItem};const hr=lang==='hr';const works=publishedWorksByIds(event.repertoireIds);const programme=programmes.find(p=>p.id===event.programme&&p.published);
const canonicalPath=hr?`/dogadjaji/${event.slug}/`:`/en/events/${event.slug}/`;const alternatePath=hr?`/en/events/${event.slug}/`:`/dogadjaji/${event.slug}/`;
const hasMedia=event.gallery.length>0||event.videos.length>0;const locationText=[event.venue,event.address,event.city,countryLabel(event.country,lang)].filter(Boolean).join(' · ');
const schema={'@context':'https://schema.org','@type':'MusicEvent',name:hr?event.titleHr:event.titleEn,description:hr?event.descriptionHr:event.descriptionEn,startDate:event.time?`${event.date}T${event.time}:00${['11','12','01','02','03'].includes(event.date.slice(5,7))?'+01:00':'+02:00'}`:event.date,image:event.posterImage?new URL(path(event.posterImage),Astro.site).href:undefined,location:{'@type':'Place',name:event.venue,address:{'@type':'PostalAddress',streetAddress:event.address,addressLocality:event.city,addressCountry:event.country}},performer:{'@type':'MusicGroup',name:hr?'Zagrebački tamburaški kvartet':'Zagreb Tambura Quartet'},workPerformed:works.map(work=>({'@type':'MusicComposition',name:workTitle(work,lang),composer:{'@type':'Person',name:work.composer}}))};
---
<BaseLayout {lang} title={`${hr?event.titleHr:event.titleEn} — ZTK`} description={`${formatDate(event.date,lang)} · ${locationText}`} image={event.posterImage||event.heroImage} {canonicalPath} {alternatePath} {schema}>
 <Hero eyebrow={`${formatDate(event.date,lang)}${event.endDate?' – '+formatDate(event.endDate,lang):''}${event.time?' · '+event.time:''}`} title={hr?event.titleHr:event.titleEn} subtitle={hr?event.subtitleHr:event.subtitleEn} description={locationText} photo={event.heroImage} photoAlt={hr?'Zagrebački tamburaški kvartet na koncertu':'Zagreb Tambura Quartet in concert'} compact />
 <section class="section"><div class="container"><nav class="tabs" aria-label={hr?'Sadržaj događaja':'Event content'}><a href="#program">{hr?'Program':'Programme'}</a>{event.posterImage&&<a href="#poster">{hr?'Plakat':'Poster'}</a>}{works.length>0&&<a href="#works">{hr?'O djelima':'About the works'}</a>}<a href="#performers">{hr?'Izvođači':'Performers'}</a><a href="#location">{hr?'Lokacija':'Location'}</a>{hasMedia&&<a href="#media">{hr?'Mediji':'Media'}</a>}</nav>
 {event.digitalProgrammeEnabled&&works.length>0?<article class="digital card" id="program"><div><p class="eyebrow">{hr?'Digitalni koncertni program':'Digital concert programme'}</p><h2>{programme&&(hr?programme.titleHr:programme.titleEn)}</h2><p class="lead">{formatDate(event.date,lang)}{event.time&&` · ${event.time}`}<br>{event.venue}</p></div>{works.length?<ol>{works.map(work=><li><span>{work.composer}</span><a href={`#work-${work.id}`}><i>{workTitle(work,lang)}</i></a></li>)}</ol>:null}</article>:<article class="event-summary card" id="program"><p class="eyebrow">{hr?'O događaju':'About the event'}</p><h2>{hr?event.titleHr:event.titleEn}</h2>{(hr?event.descriptionHr:event.descriptionEn)&&<p class="lead">{hr?event.descriptionHr:event.descriptionEn}</p>}{event.durationHr&&<p>{hr?'Trajanje: '+event.durationHr:'Duration: '+event.durationEn}</p>}</article>}</div></section>
 {event.posterImage&&<section class="section poster-section" id="poster"><div class="container poster-layout"><div class="poster-copy"><p class="eyebrow">{hr?'Službeni plakat':'Official poster'}</p><h2>{hr?'Koncert i razgovor.':'Concert and conversation.'}</h2><p class="lead">{hr?event.descriptionHr:event.descriptionEn}</p>{event.posterOriginal&&<a class="button outline" href={path(event.posterOriginal)} target="_blank" rel="noreferrer">{hr?'Otvori plakat u punoj veličini':'Open full-size poster'} <span aria-hidden="true">↗</span></a>}</div><figure class="event-poster"><a href={path(event.posterOriginal??event.posterImage)} target="_blank" rel="noreferrer" aria-label={hr?'Otvori službeni plakat u punoj veličini':'Open the official poster full size'}><img src={path(event.posterImage)} alt={hr?'Službeni plakat promocije albuma Tambura da camera, 30. rujna 2026. u Zagrebu':'Official poster for the Tambura da camera album presentation, 30 September 2026 in Zagreb'} width="1000" height="1414" loading="lazy" /></a><figcaption>{hr?'Originalni vizual događaja':'Original event artwork'}</figcaption></figure></div></section>}
 {works.length>0&&<section class="section alt" id="works"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'O djelima':'About the works'}</p><h2>{hr?'Glazba izbliza.':'Inside the music.'}</h2></div><div class="works">{works.map(work=>{const workVideo=workVideos(work);return <article id={`work-${work.id}`} class="work"><p class="eyebrow">{work.composer}</p><div><h3><i>{workTitle(work,lang)}</i></h3>{(hr?work.descriptionHr:work.descriptionEn)&&<p>{hr?work.descriptionHr:work.descriptionEn}</p>}{work.movements?.length&&<ol class="movement-list">{work.movements.map(movement=><li>{hr?movement.titleHr:movement.titleEn}</li>)}</ol>}</div><div class="work-links">{workVideo.map(video=><a class="text-link" href={video.url} target="_blank" rel="noreferrer">{hr?video.movementHr:video.movementEn} <span>↗</span></a>)}</div></article>})}</div></div></section>}
 <section class="section" id="performers"><div class="container grid-2"><div class="section-head"><p class="eyebrow">{hr?'Izvođači':'Performers'}</p><h2>{hr?'Zagrebački tamburaški kvartet':'Zagreb Tambura Quartet'}</h2></div><div class="stack"><ul class="performers">{members.filter(m=>m.published).map(member=><li><strong>{member.name}</strong><span>{member.instrument[lang]}</span></li>)}</ul>{event.guestArtists.length>0&&<p>{event.guestArtists.join(' · ')}</p>}{event.moderator&&<p><strong>{hr?'Moderatorica':'Moderator'}:</strong> {event.moderator}</p>}</div></div></section>
 <section class="section alt" id="location"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Lokacija':'Location'}</p><h2>{event.venue||event.city||event.country}</h2><p class="lead">{[event.address,event.city,countryLabel(event.country,lang)].filter(Boolean).join(', ')}</p></div><EventsMap events={[event]} places={performancePlaces.filter(p=>p.city===event.city)} {lang}/></div></section>
 {hasMedia&&<section class="section" id="media"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Mediji':'Media'}</p><h2>{hr?'S koncertne pozornice':'From the concert stage'}</h2></div><div class="grid-2">{event.gallery.map(src=><img src={path(src)} alt={hr?'Fotografija s koncerta':'Concert photograph'} loading="lazy" />)}{event.videos.map(url=><a class="text-link" href={url} target="_blank" rel="noreferrer">{hr?'Pogledajte snimku':'Watch the recording'} ↗</a>)}</div></div></section>}
</BaseLayout>
<style>
  .tabs { display:flex; gap:9px; overflow:auto; margin-bottom:42px; padding-bottom:8px; }
  .tabs a { white-space:nowrap; padding:.75rem 1rem; border:1px solid var(--color-line); border-radius:2px; background:var(--color-paper); font-size:.76rem; font-weight:700; letter-spacing:.04em; text-decoration:none; }
  .tabs a:hover { border-color:var(--color-copper); }
  .digital { display:grid; grid-template-columns:.8fr 1.2fr; gap:60px; padding:clamp(30px,6vw,74px); border-radius:4px; border-top:4px solid var(--color-moss-500); }
  .digital ol { margin:0; padding:0; list-style:none; }
  .digital li { display:grid; gap:3px; padding:17px 0; border-bottom:1px solid var(--color-line); }
  .digital li span { color:var(--color-muted); font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; }
  .digital li a { font:500 1.45rem var(--serif); text-decoration-color:var(--color-copper); }
  .event-summary { padding:clamp(30px,6vw,64px); border-radius:4px; border-left:4px solid var(--color-moss-500); }
  .poster-section { background:var(--color-navy-900); color:var(--color-paper); overflow:hidden; }
  .poster-layout { display:grid; grid-template-columns:minmax(0,.8fr) minmax(300px,.62fr); gap:clamp(40px,8vw,110px); align-items:center; }
  .poster-copy { max-width:580px; }
  .poster-copy h2 { color:var(--color-paper); }
  .poster-copy p:not(.eyebrow) { color:rgba(247,249,252,.78); }
  .poster-copy .button { margin-top:20px; color:var(--color-paper); border-color:rgba(247,249,252,.5); }
  .poster-copy .button:hover { border-color:var(--color-copper); }
  .event-poster { margin:0; justify-self:end; width:min(100%,520px); }
  .event-poster a { display:block; border:0; box-shadow:none; background:#08162b; }
  .event-poster img { display:block; width:100%; height:auto; }
  .event-poster figcaption { margin-top:12px; color:rgba(247,249,252,.55); font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; }
  .works { display:grid; gap:0; border-top:1px solid var(--color-line); }
  .work { display:grid; grid-template-columns:.7fr 1fr 1fr; gap:24px; padding:30px 0; border-bottom:1px solid var(--color-line); }
  .work-links { display:grid; align-content:start; justify-items:end; gap:9px; }
  .movement-list { margin:16px 0 0; padding-left:1.2rem; color:var(--color-muted); }
  .movement-list li+li { margin-top:5px; }
  .performers { list-style:none; margin:0; padding:0; }
  .performers li { display:flex; justify-content:space-between; gap:20px; padding:15px 0; border-bottom:1px solid var(--color-line); }
  .performers span { color:var(--color-muted); }
  @media(max-width:750px){.digital,.work,.poster-layout{grid-template-columns:1fr;gap:30px}.work-links{justify-items:start}.event-poster{justify-self:stretch;width:100%}.poster-copy .button{width:100%;justify-content:center}}
</style>
