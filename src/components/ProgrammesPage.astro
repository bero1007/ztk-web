---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Hero from '@/components/Hero.astro'; import { programmes,published } from '@/data/content'; import type {Lang} from '@/data/content'; import {path,routes} from '@/lib/i18n';
const {lang}=Astro.props as {lang:Lang};const r=routes(lang);const hr=lang==='hr';
---
<BaseLayout {lang} title={hr?'Aktualni programi — ZTK':'Current programmes — ZTK'} description={hr?'Aktualni koncertni programi Zagrebačkog tamburaškog kvarteta.':'Current concert programmes by Zagreb Tambura Quartet.'} canonicalPath={r.programmes} alternatePath={hr?'/en/programmes/':'/programi/'}>
 <Hero eyebrow={hr?'Aktualni programi':'Current programmes'} title={hr?'Programi za <em>pozornice</em> koje slušaju.':'Programmes for <em>stages</em> that listen.'} description={hr?'Od Mozarta do suvremene tamburaške komorne glazbe.':'From Mozart to contemporary chamber music for tambura.'} photo="/images/ensemble/jev-03586.webp" photoAlt={hr?'Zagrebački tamburaški kvartet na pozornici':'Zagreb Tambura Quartet on stage'} programmeMotif />
 <section class="section"><div class="container programme-list">{published(programmes).map((program,index)=><article class="programme-card"><div class:list={['programme-visual',program.id==='tambura-da-camera'&&'album']}>{program.image?<img src={path(program.image)} alt={hr?program.titleHr:program.titleEn} loading="lazy" />:<span>{String(index+1).padStart(2,'0')}</span>}</div><div class="stack"><p class="eyebrow">{program.duration|| (hr?'Trajanje po dogovoru':'Duration by arrangement')}</p><h2>{hr?program.titleHr:program.titleEn}</h2><p class="lead">{hr?program.descriptionHr:program.descriptionEn}</p>{program.performers&&<p><strong>{hr?'Izvođači':'Performers'}:</strong> {program.performers}</p>}{program.repertoire&&<ul>{program.repertoire.map(item=><li>{item}</li>)}</ul>}<a class="button" href={path(`${r.booking}?program=${program.id}`)}>{hr?'Rezervirajte ovaj program':'Book this programme'} →</a></div></article>)}</div></section>
 </BaseLayout>
<style>.programme-list{display:grid;gap:32px}.programme-card{display:grid;grid-template-columns:minmax(260px,.75fr) 1.25fr;gap:clamp(26px,5vw,70px);padding:clamp(22px,3vw,36px);background:rgba(247,249,252,.95);border:1px solid var(--color-line);border-radius:var(--radius-lg);box-shadow:var(--shadow-soft);align-items:center}.programme-visual{min-height:330px;aspect-ratio:1.08;border-radius:var(--radius-md);background:linear-gradient(145deg,#dce7f2,#9eb3cb);display:grid;place-items:center;overflow:hidden;color:var(--color-navy-900);font:600 5rem var(--serif)}.programme-visual img{width:100%;height:100%;object-fit:cover}.programme-visual.album{background:#0c274b;border-radius:50% 50% 20px 20px}.programme-visual.album img{object-fit:cover}.programme-card .button{justify-self:start}.programme-card ul{margin:0;padding-left:1.2rem}@media(max-width:750px){.programme-card{grid-template-columns:1fr}.programme-visual{min-height:210px}.programme-card h2{font-size:2.7rem}}</style>
