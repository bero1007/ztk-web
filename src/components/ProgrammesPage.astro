---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Hero from '@/components/Hero.astro'; import { programmeWorks,programmes,published,workTitle } from '@/data/content'; import type {Lang} from '@/data/content'; import {path,routes} from '@/lib/i18n';
const {lang}=Astro.props as {lang:Lang};const r=routes(lang);const hr=lang==='hr';
---
<BaseLayout {lang} title={hr?'Aktualni programi — ZTK':'Current programmes — ZTK'} description={hr?'Aktualni koncertni programi Zagrebačkog tamburaškog kvarteta.':'Current concert programmes by Zagreb Tambura Quartet.'} canonicalPath={r.programmes} alternatePath={hr?'/en/programmes/':'/programi/'}>
 <Hero eyebrow={hr?'Aktualni programi':'Current programmes'} title={hr?'Programi za sve<br><em>pozornice.</em>':'Programmes for<br><em>every stage.</em>'} description={hr?'Od Mozarta do suvremene tamburaške komorne glazbe.':'From Mozart to contemporary chamber music for tambura.'} photo="/images/ensemble/jev-03586.webp" photoAlt={hr?'Zagrebački tamburaški kvartet na pozornici':'Zagreb Tambura Quartet on stage'} programmeMotif />
 <section class="section"><div class="container programme-list">{published(programmes).map((program,index)=>{const works=programmeWorks(program);return <article id={`programme-${program.id}`} class="programme-card"><div class:list={['programme-visual',program.id==='tambura-da-camera'&&'album']}>{program.image?<img src={path(program.image)} alt={hr?program.titleHr:program.titleEn} loading="lazy" />:<span>{String(index+1).padStart(2,'0')}</span>}</div><div class="stack"><p class="eyebrow">{(hr?program.duration:(program.durationEn||program.duration))|| (hr?'Trajanje po dogovoru':'Duration by arrangement')}</p><h2>{hr?program.titleHr:program.titleEn}</h2><p class="lead">{hr?program.descriptionHr:program.descriptionEn}</p>{program.performers&&<p><strong>{hr?'Izvođači':'Performers'}:</strong> {hr?(program.performersHr||program.performers):program.performers}</p>}{works.length>0&&<ol class="programme-works">{works.map(work=><li><span>{work.composer}</span><a href={path(hr?`/repertoar/${work.slug}/`:`/en/repertoire/${work.slug}/`)}><i>{workTitle(work,lang)}</i></a></li>)}</ol>}<a class="button" href={path(`${r.booking}?program=${program.id}`)}>{hr?'Rezervirajte ovaj program':'Book this programme'} →</a></div></article>})}</div></section>
 </BaseLayout>
<style>
  .programme-list { display:grid; gap:34px; }
  .programme-card { position:relative; display:grid; grid-template-columns:minmax(270px,.78fr) 1.22fr; gap:clamp(30px,5vw,72px); align-items:center; padding:clamp(24px,3vw,38px); overflow:hidden; background:rgba(250,249,245,.94); border:1px solid var(--color-line); border-radius:4px; box-shadow:var(--shadow-soft); }
  .programme-card::before { content:''; position:absolute; inset:0 auto 0 0; width:3px; background:var(--color-moss-500); }
  .programme-card:nth-child(even) .programme-visual { order:2; }
  .programme-visual { min-height:340px; aspect-ratio:1.08; display:grid; place-items:center; overflow:hidden; border:1px solid var(--color-line); border-radius:150px 150px 3px 3px; background:linear-gradient(145deg,var(--color-moss-100),#c5d0cf); color:var(--color-navy-900); font:500 5rem var(--serif); }
  .programme-visual img { width:100%; height:100%; object-fit:cover; filter:saturate(.88); }
  .programme-visual.album { background:var(--color-navy-900); border-radius:3px; }
  .programme-visual.album img { object-fit:cover; filter:none; }
  .programme-card .button { justify-self:start; }
  .programme-works { margin:0; padding:0; list-style:none; border-top:1px solid var(--color-line); }
  .programme-works li { display:grid; gap:2px; padding:12px 0; border-bottom:1px solid var(--color-line); }
  .programme-works span { color:var(--color-muted); font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; }
  .programme-works a { font:500 1.08rem var(--serif); text-decoration-color:var(--color-copper); }
  @media(max-width:750px){
    .programme-card { grid-template-columns:1fr; }
    .programme-card:nth-child(even) .programme-visual { order:0; }
    .programme-visual { min-height:240px; border-radius:120px 120px 3px 3px; }
    .programme-visual.album { border-radius:3px; }
    .programme-card h2 { font-size:2.7rem; }
  }
</style>
