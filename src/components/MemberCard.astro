---
import type { Member, Lang } from '@/data/content';
import { path } from '@/lib/i18n';
const { member, lang } = Astro.props as { member: Member; lang: Lang };
const href = lang === 'hr' ? `/kvartet/${member.slug}/` : `/en/quartet/${member.slug}/`;
---
<article class="member-card">
  <div class="portrait" role="img" aria-label={`${member.name} — fotografija će biti dodana`}><span>TODO · fotografija</span></div>
  <div><p class="eyebrow">{member.instrument[lang]}</p><h3>{member.name}</h3><a class="text-link" href={path(href)}>{lang === 'hr' ? 'Upoznajte člana' : 'Meet the member'} <span>→</span></a></div>
</article>
<style>
  .member-card { display: grid; gap: 20px; }
  .portrait { aspect-ratio: .82; border-radius: 48% 48% 18px 18px; background: linear-gradient(145deg, #dce7f2, #96abc5); position: relative; overflow: hidden; }
  .portrait::after { content: ''; position: absolute; inset: 18% 24% -10%; border-radius: 50% 50% 20% 20%; background: rgba(12,39,75,.18); }
  .portrait span { position: absolute; bottom: 12px; left: 14px; z-index: 1; font-size: .62rem; letter-spacing: .06em; text-transform: uppercase; }
  .member-card > div:last-child { display: grid; gap: 9px; }
  h3 { font-size: clamp(1.45rem, 2.4vw, 2.1rem); }
  @media (max-width:560px) { .member-card .text-link { font-size: .74rem; } }
</style>
