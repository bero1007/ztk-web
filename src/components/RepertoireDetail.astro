---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import type{Lang,Work}from '@/data/content';import{path,routes}from '@/lib/i18n';
const{lang,work}=Astro.props as{lang:Lang;work:Work};const hr=lang==='hr';const r=routes(lang);const canonicalPath=hr?`/repertoar/${work.slug}/`:`/en/repertoire/${work.slug}/`;const alternatePath=hr?`/en/repertoire/${work.slug}/`:`/repertoar/${work.slug}/`;const schema={'@context':'https://schema.org','@type':'MusicComposition',name:work.title,composer:{'@type':'Person',name:work.composer}};
---
<BaseLayout {lang} title={`${work.title} — ${work.composer} — ZTK`} description={`${work.composer}: ${work.title}. ${hr?'Djelo u repertoaru Zagrebačkog tamburaškog kvarteta.':'A work in Zagreb Tambura Quartet’s repertoire.'}`} {canonicalPath} {alternatePath} {schema}>
 <Hero eyebrow={work.composer} title={`<em>${work.title}</em>`} description={hr?'Iz repertoara Zagrebačkog tamburaškog kvarteta.':'From the repertoire of Zagreb Tambura Quartet.'} compact />
 <section class="section"><div class="container grid-2"><div class="section-head"><p class="eyebrow">{hr?'Podaci o djelu':'Work details'}</p><h2>{work.title}</h2></div><dl class="details">{work.arranger&&<><dt>{hr?'Aranžman':'Arrangement'}</dt><dd>{work.arranger}</dd></>}{work.album&&<><dt>Album</dt><dd>{work.album}</dd></>}<dt>{hr?'Pisano za ZTK':'Written for ZTK'}</dt><dd>{work.writtenForZtk==='unknown'?(hr?'Nepotvrđeno':'Unconfirmed'):work.writtenForZtk?(hr?'Da':'Yes'):(hr?'Ne':'No')}</dd><dt>{hr?'Opis':'Programme note'}</dt><dd>{(hr?work.descriptionHr:work.descriptionEn)|| (hr?'Čeka autorizirani sadržaj.':'Awaiting approved copy.')}</dd></dl></div></section>
 {work.videoUrls.length>0&&<section class="section alt"><div class="container"><div class="section-head"><p class="eyebrow">Video</p><h2>{hr?'Slušajte odabrane stavke':'Listen to selected movements'}</h2></div><div class="stack">{work.videoUrls.map((url,i)=><a class="card text-link" href={url} target="_blank" rel="noreferrer">Video {i+1} <span>↗</span></a>)}</div></div></section>}
 <section class="section compact"><div class="container"><a class="button" href={path(r.repertoire)}>← {hr?'Natrag na repertoar':'Back to repertoire'}</a></div></section>
</BaseLayout>
<style>.details{margin:0}.details dt{margin-top:20px;color:var(--color-muted);font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.details dd{margin:3px 0 0;font-size:1.05rem}.details dd+dt{border-top:1px solid var(--color-line);padding-top:20px}</style>
