---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Hero from '@/components/Hero.astro'; import MemberCard from '@/components/MemberCard.astro';
import { members, published, ensembleBiography, ensembleHighlights } from '@/data/content'; import type { Lang } from '@/data/content'; import { path, routes } from '@/lib/i18n';
const { lang }=Astro.props as {lang:Lang}; const r=routes(lang); const hr=lang==='hr';
const schema = published(members).map((member) => ({'@context':'https://schema.org','@type':'Person',name:member.name,memberOf:{'@type':'MusicGroup',name:'Zagreb Tambura Quartet'}}));
---
<BaseLayout {lang} title={hr?'Kvartet — Zagrebački tamburaški kvartet':'Quartet — Zagreb Tambura Quartet'} description={hr?'Četiri glazbenika, jedan suvremeni komorni zvuk tambure.':'Four musicians, one contemporary chamber voice for the tambura.'} canonicalPath={r.quartet} alternatePath={hr?'/en/quartet/':'/kvartet/'} {schema}>
  <Hero eyebrow={hr?'Ansambl':'Ensemble'} title={hr?'Četiri glasa.<br><em>Jedan zvuk.</em>':'Four voices.<br><em>One sound.</em>'} description={hr?'Prvi profesionalni tamburaški kvartet u svijetu.':'The world’s first professional tambura quartet.'} photo="/images/ensemble/dk-101664.webp" photoAlt={hr?'Zagrebački tamburaški kvartet uz kameni zid':'Zagreb Tambura Quartet by a stone wall'} />
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Članovi':'Members'}</p><h2>{hr?'Kvartet izbliza':'Meet the quartet'}</h2></div><div class="grid-4">{published(members).map((member)=><MemberCard {member} {lang}/>)}</div></div></section>
  <section class="section alt"><div class="container grid-2 biography"><figure><img src={path('/images/ensemble/jev-03491.webp')} alt={hr?'Zagrebački tamburaški kvartet na koncertu':'Zagreb Tambura Quartet in concert'} loading="lazy" /><figcaption>{hr?'Koncertna fotografija':'Concert photograph'}</figcaption></figure><div class="stack"><p class="eyebrow">{hr?'Biografija':'Biography'}</p><h2>{hr?'Tambura kao suvremeno komorno glazbalo.':'The tambura as a contemporary chamber instrument.'}</h2><p class="lead">{ensembleBiography[lang]}</p><ul class="highlights">{ensembleHighlights[lang].map(item=><li>{item}</li>)}</ul></div></div></section>
</BaseLayout>
<style>.biography{align-items:center}.biography figure{margin:0}.biography img{width:100%;min-height:480px;object-fit:cover;border-radius:var(--radius-lg) 48% var(--radius-lg) var(--radius-lg);box-shadow:var(--shadow-soft)}figcaption{margin-top:10px;color:var(--color-muted);font-size:.72rem}.highlights{margin:0;padding:0;list-style:none;border-top:1px solid var(--color-line)}.highlights li{padding:13px 0;border-bottom:1px solid var(--color-line)}</style>
