---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import{programmes,published}from '@/data/content';import type{Lang}from '@/data/content';import{routes}from '@/lib/i18n';
const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';const r=routes(lang);const endpoint=import.meta.env.PUBLIC_BOOKING_ENDPOINT||'';
---
<BaseLayout {lang} title={hr?'Booking — Zagrebački tamburaški kvartet':'Booking — Zagreb Tambura Quartet'} description={hr?'Pošaljite koncertni upit Zagrebačkom tamburaškom kvartetu.':'Send a concert enquiry to Zagreb Tambura Quartet.'} canonicalPath={r.booking} alternatePath={hr?'/en/booking/':'/booking/'}>
 <Hero eyebrow="Booking" title={hr?'Razgovarajmo o <em>vašem koncertu.</em>':'Let’s talk about <em>your concert.</em>'} description="zagreb.tambura.quartet@gmail.com" compact />
 <section class="section"><div class="container grid-2"><div class="section-head"><p class="eyebrow">{hr?'Koncertni upit':'Concert enquiry'}</p><h2>{hr?'Recite nam osnovno.':'Tell us the essentials.'}</h2><p class="lead">{hr?'Ako backend još nije povezan, obrazac će pripremiti strukturirani e-mail u vašoj aplikaciji za poštu.':'Until a backend is connected, the form prepares a structured email in your mail app.'}</p></div><form id="booking-form" class="booking-form card" data-endpoint={endpoint} data-email="zagreb.tambura.quartet@gmail.com"><label>{hr?'Ime i prezime':'Full name'}<input required name="name" autocomplete="name" /></label><label>{hr?'Organizacija':'Organisation'}<input required name="organisation" autocomplete="organization" /></label><div class="two"><label>E-mail<input required type="email" name="email" autocomplete="email" /></label><label>{hr?'Telefon (neobavezno)':'Phone (optional)'}<input type="tel" name="phone" autocomplete="tel" /></label></div><div class="two"><label>{hr?'Grad':'City'}<input required name="city" autocomplete="address-level2" /></label><label>{hr?'Država':'Country'}<input required name="country" autocomplete="country-name" /></label></div><label>{hr?'Datum / željeni period':'Date / preferred period'}<input required name="date" /></label><label>{hr?'Vrsta događaja':'Event type'}<select required name="eventType"><option value="">—</option><option>{hr?'Koncert':'Concert'}</option><option>{hr?'Festival':'Festival'}</option><option>{hr?'Kulturni program':'Cultural programme'}</option><option>{hr?'Drugo':'Other'}</option></select></label><label>{hr?'Program':'Programme'}<select required id="programme-select" name="programme"><option value="">—</option>{published(programmes).map(program=><option value={program.id}>{hr?program.titleHr:program.titleEn}</option>)}</select></label><label>{hr?'Prostor (neobavezno)':'Venue (optional)'}<input name="venue" /></label><label>{hr?'Poruka':'Message'}<textarea required rows="5" name="message"></textarea></label><p id="form-status" role="status" aria-live="polite"></p><button class="button navy" type="submit">{hr?'Pošaljite upit':'Send enquiry'} →</button></form></div></section>
</BaseLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('#booking-form');const status=document.querySelector<HTMLElement>('#form-status');const select=document.querySelector<HTMLSelectElement>('#programme-select');const selected=new URLSearchParams(location.search).get('program');if(selected&&select&&[...select.options].some(o=>o.value===selected))select.value=selected;
 form?.addEventListener('submit',async(event)=>{event.preventDefault();if(!form.reportValidity())return;const data=Object.fromEntries(new FormData(form).entries());const endpoint=form.dataset.endpoint;if(endpoint){try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!response.ok)throw new Error();if(status)status.textContent=document.documentElement.lang==='hr'?'Upit je uspješno poslan.':'Your enquiry was sent.';form.reset();return}catch{if(status)status.textContent=document.documentElement.lang==='hr'?'Slanje nije uspjelo; otvorit ćemo pripremljeni e-mail.':'Sending failed; we will open a prepared email.'}}
 const lines=Object.entries(data).map(([key,value])=>`${key}: ${value}`);const subject=document.documentElement.lang==='hr'?`Koncertni upit — ${data.organisation}`:`Concert enquiry — ${data.organisation}`;location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`});
</script>
<style>.booking-form{display:grid;gap:16px}.booking-form label{display:grid;gap:6px;font-size:.78rem;font-weight:700}.booking-form input,.booking-form select,.booking-form textarea{width:100%;border:1px solid var(--color-line);border-radius:var(--radius-sm);background:white;padding:.82rem;color:var(--color-text)}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.booking-form .button{justify-self:start}#form-status{color:var(--color-copper);font-weight:700}@media(max-width:520px){.two{grid-template-columns:1fr}}</style>
