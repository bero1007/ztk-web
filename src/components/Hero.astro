---
import { path } from '@/lib/i18n';
interface Props { eyebrow?: string; title: string; description?: string; photo?: string; photoAlt?: string; photoPosition?: string; programmeMotif?: boolean; compact?: boolean }
const { eyebrow, title, description, photo, photoAlt = '', photoPosition = 'center', programmeMotif = false, compact = false } = Astro.props;
---
<section class:list={['hero', programmeMotif && 'programme-motif', compact && 'compact-hero']}>
  <div class:list={['container','hero-grid',!photo&&'no-photo']}>
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {description && <p class="lead">{description}</p>}
      <slot />
    </div>
    {photo ? <div class="hero-photo" role="img" aria-label={photoAlt} style={`background-image:linear-gradient(to top, rgba(7,28,55,.58),transparent 60%),url(${path(photo)});background-size:cover;background-position:${photoPosition}`} /> : null}
  </div>
</section>
<style>.compact-hero { min-height: 520px; }</style>
