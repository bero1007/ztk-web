---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Hero from '@/components/Hero.astro'; import EventsMap from '@/components/EventsMap.astro'; import {performancePlaces} from '@/data/places'; import {events,eventIsUpcoming,published,programmes} from '@/data/content'; import type{Lang}from '@/data/content';import{countryLabel,formatDate,path,routes}from '@/lib/i18n';
const {lang}=Astro.props as{lang:Lang};const r=routes(lang);const hr=lang==='hr';const visible=published(events);const upcoming=visible.filter(e=>eventIsUpcoming(e)).sort((a,b)=>a.date.localeCompare(b.date));const archive=visible.filter(e=>!eventIsUpcoming(e));const choices=(key:'country'|'city'|'programme')=>[...new Set(archive.flatMap(e=>key==='city'?[e.city,...(e.otherCities||[])]:[e[key]]).filter(Boolean))].sort();
---
<BaseLayout {lang} title={hr?'Događaji — ZTK':'Events — ZTK'} description={hr?'Nadolazeći koncerti i arhiva Zagrebačkog tamburaškog kvarteta.':'Upcoming concerts and archive of Zagreb Tambura Quartet.'} canonicalPath={r.events} alternatePath={hr?'/en/events/':'/dogadjaji/'}>
 <Hero eyebrow={hr?'Događaji':'Events'} title={hr?'Glazba se događa <em>uživo.</em>':'Music happens <em>live.</em>'} description={hr?'Nadolazeći koncerti, digitalni programi i arhiva nastupa.':'Upcoming concerts, digital programmes and performance archive.'} photo="/images/ensemble/jev-03488.webp" photoAlt={hr?'Koncert Zagrebačkog tamburaškog kvarteta':'Zagreb Tambura Quartet in concert'}/>
 <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Nadolazeći':'Upcoming'}</p><h2>{upcoming.length? (hr?'Sljedeći susreti.':'Our next performances.'):(hr?'Novi datumi uskoro.':'New dates soon.')}</h2></div>{upcoming.map(event=><article class="event-card"><div class="event-date"><strong>{new Date(`${event.date}T12:00`).getDate()}</strong><span>{formatDate(event.date,lang).replace(/^\d+\s/,'')}</span></div><div class="stack"><h3>{hr?event.titleHr:event.titleEn}</h3>{event.subtitleHr&&<p class="event-subtitle">{hr?event.subtitleHr:event.subtitleEn}</p>}<p>{event.endDate&&<span>{formatDate(event.date,lang)} – {formatDate(event.endDate,lang)}<br/></span>}{[event.time,event.venue,event.city,countryLabel(event.country,lang)].filter(Boolean).join(' · ')}</p><a class="button" href={path(hr?`/dogadjaji/${event.slug}/`:`/en/events/${event.slug}/`)}>{hr?'Otvori događaj':'Open event'} →</a></div></article>)}</div></section>
 <section class="section alt"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Karta':'Map'}</p><h2>{hr?'Mjesta susreta':'Places we meet'}</h2></div><EventsMap events={visible} places={performancePlaces} {lang}/></div></section>
 <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Arhiva':'Archive'}</p><h2>{hr?'Prošli nastupi':'Past performances'}</h2></div><div class="archive-filters" aria-label={hr?'Filteri arhive':'Archive filters'}>
<label>{hr?'Godina':'Year'}<select data-archive-filter="year"><option value="">{hr?'Sve godine':'All years'}</option>{[...new Set(archive.map(e=>e.date.slice(0,4)))].sort().reverse().map(year=><option>{year}</option>)}</select></label>
{(['country','city','programme'] as const).map((key,index)=><label>{(hr?['Država','Grad','Program']:['Country','City','Programme'])[index]}<select data-archive-filter={key}><option value="">{hr?'Sve':'All'}</option>{choices(key).map(value=><option value={value}>{key==='programme'?(hr?programmes.find(p=>p.id===value)?.titleHr:programmes.find(p=>p.id===value)?.titleEn):key==='country'?countryLabel(value!,lang):value}</option>)}</select></label>)}
<label>{hr?'Gost':'Guest'}<select data-archive-filter="guest"><option value="">{hr?'Svi':'All'}</option>{[...new Set(archive.flatMap(e=>e.guestArtists))].sort().map(name=><option>{name}</option>)}</select></label>
<button class="button outline" type="button" id="reset-archive">{hr?'Poništi filtre':'Reset filters'}</button></div>
<p id="archive-count" role="status" aria-live="polite"></p><p id="archive-empty" hidden>{hr?'Nema nastupa za odabrane filtre.':'No performances match these filters.'}</p>{archive.length?<div class="archive-list">{archive.sort((a,b)=>b.date.localeCompare(a.date)).map(event=><a data-archive-event data-year={event.date.slice(0,4)} data-country={event.country} data-city={JSON.stringify([event.city,...(event.otherCities||[])])} data-programme={event.programme||''} data-guest={JSON.stringify(event.guestArtists)} href={path(hr?`/dogadjaji/${event.slug}/`:`/en/events/${event.slug}/`)}><time datetime={event.date}>{formatDate(event.date,lang)}{event.endDate&&` – ${formatDate(event.endDate,lang)}`}</time><span><strong>{hr?event.titleHr:event.titleEn}</strong><small>{[event.venue,event.city,...(event.otherCities||[]),countryLabel(event.country,lang)].filter(Boolean).join(' · ')}</small></span><b>→</b></a>)}</div>:<p class="empty-note">{hr?'Arhivski događaji bit će automatski prikazani nakon datuma održavanja.':'Events appear here automatically after their date.'}</p>}</div></section>
</BaseLayout>
<style>
  .event-card + .event-card { margin-top:24px; }
  .event-subtitle { font-size:.95rem; }
  .archive-filters label { display:grid;gap:6px;font-size:.8rem;flex:1;min-width:140px; }
  .archive-filters select { min-height:44px;padding:10px;border:1px solid var(--color-line);background:var(--color-paper);color:var(--color-text);max-width:100%; }
  .event-card { position:relative; display:grid; grid-template-columns:150px 1fr; gap:42px; padding:clamp(30px,5vw,64px); overflow:hidden; background:var(--color-paper); border:1px solid var(--color-line); border-radius:4px; box-shadow:var(--shadow-soft); }
  .event-card::before { content:''; position:absolute; inset:0 0 auto; height:4px; background:linear-gradient(90deg,var(--color-copper) 0 18%,var(--color-moss-500) 18% 48%,transparent 48%); }
  .event-date { display:grid; align-content:start; border-right:1px solid var(--color-line); }
  .event-date strong { color:var(--color-copper); font:500 5rem/.8 var(--serif); }
  .event-date span { margin-top:12px; color:var(--color-muted); font-size:.76rem; letter-spacing:.06em; text-transform:uppercase; }
  .event-card .button { justify-self:start; }
  .archive-filters { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:30px; }
  .archive-filters button { padding:.7rem 1rem; border:1px solid var(--color-line); border-radius:999px; background:var(--color-paper); color:var(--color-muted); }
  .archive-list { border-top:1px solid var(--color-line); }
  .archive-list a { display:grid; grid-template-columns:190px 1fr auto; gap:24px; align-items:center; padding:22px 8px; border-bottom:1px solid var(--color-line); text-decoration:none; transition:padding .2s ease,background .2s ease; }
  .archive-list a:hover { padding-inline:14px; background:rgba(228,232,220,.42); }
  .archive-list time,.archive-list small { color:var(--color-muted); font-size:.78rem; }
  .archive-list span { display:grid; gap:3px; }
  .archive-list strong { font:500 1.4rem var(--serif); }
  .archive-list b { color:var(--color-copper); transition:transform .2s; }
  .archive-list a:hover b { transform:translateX(5px); }
  @media(max-width:600px){
    .event-card { grid-template-columns:1fr; gap:24px; }
    .event-date { border:0; border-bottom:1px solid var(--color-line); padding-bottom:20px; }
    .event-date strong { font-size:4rem; }
    .archive-list a { grid-template-columns:1fr auto; gap:8px; }
    .archive-list time { grid-column:1; }
    .archive-list span { grid-column:1; }
    .archive-list b { grid-column:2; grid-row:1/3; }
  }
</style>
<script>
 const filters=[...document.querySelectorAll<HTMLSelectElement>('[data-archive-filter]')];
 const rows=[...document.querySelectorAll<HTMLElement>('[data-archive-event]')];
 function filterArchive(){let count=0;rows.forEach(row=>{const show=filters.every(filter=>!filter.value||(['guest','city'].includes(filter.dataset.archiveFilter!)?JSON.parse(row.dataset[filter.dataset.archiveFilter!]||'[]').includes(filter.value):row.dataset[filter.dataset.archiveFilter!]===filter.value));row.hidden=!show;if(show)count++});
 const status=document.querySelector('#archive-count');if(status)status.textContent=(document.documentElement.lang==='hr'?'Prikazano nastupa: ':'Performances shown: ')+count;
 const empty=document.querySelector<HTMLElement>('#archive-empty');if(empty)empty.hidden=count>0;
 }
 filters.forEach(filter=>filter.addEventListener('change',filterArchive));
 document.querySelector('#reset-archive')?.addEventListener('click',()=>{filters.forEach(filter=>filter.value='');filterArchive()});filterArchive();
</script>
