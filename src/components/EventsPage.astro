---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Hero from '@/components/Hero.astro'; import EventsMap from '@/components/EventsMap.astro'; import {events,eventIsUpcoming,published} from '@/data/content'; import type{Lang}from '@/data/content';import{formatDate,path,routes}from '@/lib/i18n';
const {lang}=Astro.props as{lang:Lang};const r=routes(lang);const hr=lang==='hr';const visible=published(events);const upcoming=visible.filter(e=>eventIsUpcoming(e));const archive=visible.filter(e=>!eventIsUpcoming(e));
---
<BaseLayout {lang} title={hr?'Događaji — ZTK':'Events — ZTK'} description={hr?'Nadolazeći koncerti i arhiva Zagrebačkog tamburaškog kvarteta.':'Upcoming concerts and archive of Zagreb Tambura Quartet.'} canonicalPath={r.events} alternatePath={hr?'/en/events/':'/dogadjaji/'}>
 <Hero eyebrow={hr?'Događaji':'Events'} title={hr?'Glazba se događa <em>uživo.</em>':'Music happens <em>live.</em>'} description={hr?'Nadolazeći koncerti, digitalni programi i arhiva nastupa.':'Upcoming concerts, digital programmes and performance archive.'}/>
 <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Nadolazeći':'Upcoming'}</p><h2>{upcoming.length? (hr?'Vidimo se u Zagrebu.':'See you in Zagreb.'):(hr?'Novi datumi uskoro.':'New dates soon.')}</h2></div>{upcoming.map(event=><article class="event-card"><div class="event-date"><strong>{new Date(`${event.date}T12:00`).getDate()}</strong><span>{formatDate(event.date,lang).replace(/^\d+\s/,'')}</span></div><div class="stack"><h3>{hr?event.titleHr:event.titleEn}</h3><p>{event.time} · {event.venue}<br>{event.address}, {event.city}</p><a class="button" href={path(hr?`/dogadjaji/${event.slug}/`:`/en/events/${event.slug}/`)}>{hr?'Otvori događaj':'Open event'} →</a></div></article>)}</div></section>
 <section class="section alt"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Karta':'Map'}</p><h2>{hr?'Mjesta susreta':'Places we meet'}</h2></div><EventsMap events={visible} {lang}/></div></section>
 <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{hr?'Arhiva':'Archive'}</p><h2>{hr?'Prošli nastupi':'Past performances'}</h2></div><div class="archive-filters" aria-label={hr?'Pripremljeni filteri arhive':'Prepared archive filters'}><button disabled>{hr?'Godina':'Year'}</button><button disabled>{hr?'Država':'Country'}</button><button disabled>{hr?'Grad':'City'}</button><button disabled>{hr?'Program':'Programme'}</button><button disabled>{hr?'Gost':'Guest'}</button></div>{archive.length===0&&<p class="empty-note">{hr?'Arhivski događaji bit će automatski prikazani nakon datuma održavanja.':'Events appear here automatically after their date.'}</p>}</div></section>
</BaseLayout>
<style>.event-card{display:grid;grid-template-columns:150px 1fr;gap:40px;background:#f7f9fc;border:1px solid var(--color-line);border-radius:var(--radius-lg);box-shadow:var(--shadow-soft);padding:clamp(28px,5vw,62px)}.event-date{display:grid;align-content:start;border-right:1px solid var(--color-line)}.event-date strong{font:600 5rem/.8 var(--serif);color:var(--color-copper)}.event-date span{font-size:.8rem;margin-top:12px}.event-card .button{justify-self:start}.archive-filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:30px}.archive-filters button{padding:.7rem 1rem;border:1px solid var(--color-line);border-radius:999px;background:white;color:var(--color-muted)}@media(max-width:600px){.event-card{grid-template-columns:1fr;gap:24px}.event-date{border:0;border-bottom:1px solid var(--color-line);padding-bottom:20px}.event-date strong{font-size:4rem}}</style>
