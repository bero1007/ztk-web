---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { events, programmes, repertoire, published } from '@/data/content';
import type { Lang } from '@/data/content';
import { formatDate, path, routes } from '@/lib/i18n';
const { lang } = Astro.props as { lang: Lang }; const r = routes(lang);
const event = published(events)[0]; const featured = programmes.find((p) => p.id === 'mozart')!;
const title = lang === 'hr' ? 'Zagrebački tamburaški kvartet' : 'Zagreb Tambura Quartet';
const description = lang === 'hr' ? 'Suvremeni komorni ansambl koji tradiciju tambure predstavlja kroz klasični i suvremeni repertoar.' : 'A contemporary chamber ensemble presenting the tambura through classical and contemporary repertoire.';
const schema = { '@context': 'https://schema.org', '@type': 'MusicGroup', name: ['Zagrebački tamburaški kvartet', 'Zagreb Tambura Quartet'], email: 'zagreb.tambura.quartet@gmail.com', sameAs: ['https://www.youtube.com/@zagreb.tambura.quartet','https://www.instagram.com/zagreb.tambura.quartet/'] };
---
<BaseLayout {lang} title={`${title} — ${lang === 'hr' ? 'službena stranica' : 'official website'}`} {description} canonicalPath={r.home} alternatePath={lang === 'hr' ? '/en/' : '/'} {schema}>
  <Hero eyebrow="Zagreb Tambura Quartet" title={lang === 'hr' ? 'Tradicija u <em>suvremenom</em> izrazu.' : 'Tradition in a <em>contemporary</em> voice.'} description={description} photo="/images/ensemble/dk-101470.webp" photoAlt={lang === 'hr' ? 'Zagrebački tamburaški kvartet s instrumentima' : 'Zagreb Tambura Quartet with their instruments'} photoPosition="center" />
  <section class="section"><div class="container grid-2 next">
    <div class="section-head"><p class="eyebrow">{lang === 'hr' ? 'Sljedeći koncert' : 'Next concert'}</p><h2>{lang === 'hr' ? event.titleHr : event.titleEn}</h2></div>
    <div class="card stack"><p class="date">{formatDate(event.date, lang)} · {event.time}</p><p>{event.venue}<br />{event.address}, {event.city}</p><a class="button" href={path(lang === 'hr' ? `/dogadjaji/${event.slug}/` : `/en/events/${event.slug}/`)}>{lang === 'hr' ? 'Digitalni program' : 'Digital programme'} →</a></div>
  </div></section>
  <section class="section alt"><div class="container"><div class="section-head"><p class="eyebrow">{lang === 'hr' ? 'Istaknuti program' : 'Featured programme'}</p><h2>{featured.titleHr}</h2><p class="lead">{lang === 'hr' ? featured.descriptionHr : featured.descriptionEn}</p></div><div class="programme-line"><div><p class="meta">{featured.duration} · {featured.performers}</p><ul>{featured.repertoire?.map((item) => <li>{item}</li>)}</ul></div><a class="button navy" href={path(`${r.booking}?program=${featured.id}`)}>{lang === 'hr' ? 'Rezervirajte program' : 'Book this programme'}</a></div></div></section>
  <section class="section dark album"><div class="container grid-2"><div class="album-art"><img src={path('/images/album/tambura-da-camera-cover.webp')} alt="Tambura da camera — Zagreb Tambura Quartet" loading="lazy" /></div><div class="stack"><p class="eyebrow">Album · 2025</p><h2>Tambura da camera</h2><p class="lead">{lang === 'hr' ? 'Prvi samostalni nosač zvuka kvarteta. Skladba Hommage à Emil Cossetto Tomislava Uhlika s albuma nominirana je za nagradu Porin.' : 'The quartet’s first independent album. Tomislav Uhlik’s Hommage à Emil Cossetto from the release received a Porin Award nomination.'}</p><a class="button light" href={path(r.programmes)}>{lang === 'hr' ? 'Istražite program' : 'Explore the programme'} →</a></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">{lang === 'hr' ? 'Repertoar' : 'Repertoire'}</p><h2>{lang === 'hr' ? 'Glazba bez žanrovskih prečaca.' : 'Music without shortcuts.'}</h2><p class="lead">{published(repertoire).length} {lang === 'hr' ? 'početnih zapisa u rastućoj digitalnoj zbirci.' : 'initial records in a growing digital collection.'}</p></div><div class="work-teaser">{published(repertoire).slice(0,4).map((work) => <p><span>{work.composer}</span><i>{work.title}</i></p>)}</div><a class="button" href={path(r.repertoire)}>{lang === 'hr' ? 'Otvorite Repertoire Explorer' : 'Open Repertoire Explorer'} →</a></div></section>
  <section class="section compact"><div class="container booking-cta"><div><p class="eyebrow">Booking</p><h2>{lang === 'hr' ? 'Dovedite ZTK na svoju pozornicu.' : 'Bring ZTK to your stage.'}</h2></div><a class="button light" href={path(r.booking)}>{lang === 'hr' ? 'Pošaljite upit' : 'Send an enquiry'} →</a></div></section>
</BaseLayout>
<style>
  .next { align-items: end; }.next .section-head { margin:0 }.date { color:var(--color-copper);font-weight:700 }.programme-line { display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end }.programme-line ul { padding-left:1.1rem;margin:20px 0 0 }.album-art { aspect-ratio:1;max-width:520px;background:#0a2140;border:1px solid rgba(255,255,255,.15);position:relative;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.2) }.album-art img { width:100%;height:100%;object-fit:cover }.album .stack {align-content:center}.work-teaser { margin-bottom:38px;border-top:1px solid var(--color-line) }.work-teaser p { display:grid;grid-template-columns:1fr 1fr;padding:18px 0;border-bottom:1px solid var(--color-line) }.work-teaser i {font:500 1.35rem var(--serif)}.booking-cta {background:var(--color-navy-800);color:white;border-radius:var(--radius-lg);padding:clamp(34px,6vw,74px);display:flex;align-items:center;justify-content:space-between;gap:28px}.booking-cta h2{font-size:clamp(2.4rem,5vw,4.5rem)}
  @media(max-width:700px){.programme-line{grid-template-columns:1fr}.booking-cta{align-items:flex-start;flex-direction:column}.work-teaser p{grid-template-columns:1fr;gap:4px}}
</style>
