---
import type{Lang}from '@/data/content';const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';
---
<form class="submission card" data-email="zagreb.tambura.quartet@gmail.com"><label>{hr?'Ime':'Name'}<input required name="name" /></label><label>Email<input required type="email" name="email" /></label><label>{hr?'Naziv skladbe':'Work title'}<input required name="title" /></label><div class="two"><label>{hr?'Trajanje':'Duration'}<input name="duration" /></label><label>{hr?'Instrumentacija':'Instrumentation'}<input name="instrumentation" /></label></div><label>{hr?'Kratki opis':'Short description'}<textarea name="description" rows="3"></textarea></label><label>{hr?'Link na partituru':'Score link'}<input type="url" name="score" /></label><label>{hr?'Link na audio/demo':'Audio/demo link'}<input type="url" name="audio" /></label><label>{hr?'Poruka':'Message'}<textarea name="message" rows="4"></textarea></label><button class="button navy" type="submit">{hr?'Pripremi e-mail':'Prepare email'} →</button></form>
<script>
 document.querySelector<HTMLFormElement>('.submission')?.addEventListener('submit',(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const data=new FormData(form);const lines=[...data.entries()].map(([k,v])=>`${k}: ${v}`);window.location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(`New composition: ${data.get('title')}`)}&body=${encodeURIComponent(lines.join('\n'))}`});
</script>
<style>.submission{display:grid;gap:16px}.submission label{display:grid;gap:6px;font-size:.78rem;font-weight:700}.submission input,.submission textarea{width:100%;border:1px solid var(--color-line);border-radius:var(--radius-sm);background:white;padding:.8rem;color:var(--color-text)}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.submission .button{justify-self:start}@media(max-width:500px){.two{grid-template-columns:1fr}}</style>
