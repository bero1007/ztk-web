---
import{path,routes}from '@/lib/i18n';import type{Lang}from '@/data/content';const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';
---
<form class="submission card" data-email="zagreb.tambura.quartet@gmail.com"><label>{hr?'Ime':'Name'}<input required name="name" /></label><label>Email<input required type="email" name="email" /></label><label>{hr?'Naziv skladbe':'Work title'}<input required name="title" /></label><div class="two"><label>{hr?'Trajanje':'Duration'}<input name="duration" /></label><label>{hr?'Instrumentacija':'Instrumentation'}<input name="instrumentation" /></label></div><label>{hr?'Kratki opis':'Short description'}<textarea name="description" rows="3"></textarea></label><label>{hr?'Link na partituru':'Score link'}<input type="url" name="score" /></label><label>{hr?'Link na audio/demo':'Audio/demo link'}<input type="url" name="audio" /></label><label>{hr?'Poruka':'Message'}<textarea name="message" rows="4"></textarea></label><p>{hr?'Obrazac priprema e-mail koji šaljete iz svoje aplikacije za poštu.':'This form prepares an email to send from your mail app.'} <a href={path(routes(lang).privacy)}>{hr?'Privatnost':'Privacy'}</a></p><p class="submission-status" role="status"></p><button class="button navy" type="submit">{hr?'Pripremi e-mail':'Prepare email'} →</button></form>
<script>
 import{formPayload,mailtoFor}from '@/lib/forms';
 document.querySelector<HTMLFormElement>('.submission')?.addEventListener('submit',event=>{
 event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;
 const data=formPayload(form);const hr=document.documentElement.lang==='hr';
 const status=form.querySelector('.submission-status');if(status)status.textContent=hr?'E-mail je pripremljen. Pošaljite ga iz svoje aplikacije za poštu.':'Your email is prepared. Send it from your mail app.';
 window.location.href=mailtoFor(form,data,(hr?'Nova skladba: ':'New composition: ')+data.title);
 });
</script>
<style>
  .submission { display:grid; gap:18px; border-radius:4px; border-top:3px solid var(--color-moss-500); }
  .submission label { display:grid; gap:7px; color:var(--color-muted); font-size:.75rem; font-weight:700; letter-spacing:.055em; text-transform:uppercase; }
  .submission input,.submission textarea { width:100%; padding:.86rem; border:1px solid var(--color-line); border-radius:2px; background:#fffefa; color:var(--color-text); text-transform:none; letter-spacing:normal; }
  .submission input:focus,.submission textarea:focus { border-color:var(--color-moss-700); box-shadow:0 0 0 3px rgba(120,128,100,.14); outline:none; }
  .two { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .submission .button { justify-self:start; }
  @media(max-width:500px){.two{grid-template-columns:1fr}}
</style>
