---
import BaseLayout from '@/layouts/BaseLayout.astro';import Hero from '@/components/Hero.astro';import SubmissionForm from '@/components/SubmissionForm.astro';import{published,repertoire}from '@/data/content';import type{Lang}from '@/data/content';import{path,routes}from '@/lib/i18n';
const{lang}=Astro.props as{lang:Lang};const hr=lang==='hr';const r=routes(lang);const works=published(repertoire);
const filters=hr?[['all','Sve'],['original','Originalna djela'],['arrangement','Obrade'],['croatian','Hrvatski skladatelji'],['international','Međunarodni skladatelji'],['classical','Klasicizam'],['20th','20. stoljeće'],['contemporary','21. stoljeće / suvremena'],['video','Video dostupan'],['album','Album'],['for-ztk','Djela pisana za ZTK']]:[['all','All'],['original','Original works'],['arrangement','Arrangements'],['croatian','Croatian composers'],['international','International composers'],['classical','Classical period'],['20th','20th century'],['contemporary','21st century / contemporary'],['video','Video available'],['album','Album'],['for-ztk','Written for ZTK']];
---
<BaseLayout {lang} title={hr?'Repertoar — ZTK':'Repertoire — ZTK'} description={hr?'Pretražite djela u repertoaru Zagrebačkog tamburaškog kvarteta.':'Explore works in Zagreb Tambura Quartet’s repertoire.'} canonicalPath={r.repertoire} alternatePath={hr?'/en/repertoire/':'/repertoar/'}>
 <Hero eyebrow="Repertoire Explorer" title={hr?'Glazba koju <em>nosimo.</em>':'Music we <em>carry.</em>'} description={hr?'Pretražite skladatelje, djela, programe i dostupne videozapise.':'Search composers, works, programmes and available videos.'} compact />
 <section class="section"><div class="container explorer" data-lang={lang}><label class="search"><span>{hr?'Pretražite repertoar':'Search repertoire'}</span><input id="work-search" type="search" placeholder={hr?'Skladatelj ili djelo…':'Composer or work…'} /></label><div class="filters" role="group" aria-label={hr?'Filtri repertoara':'Repertoire filters'}>{filters.map(([id,label],i)=><button class:list={[i===0&&'active']} data-filter={id} type="button">{label}</button>)}</div><div id="work-list" class="work-list">{works.map(work=><article data-text={`${work.composer} ${work.title}`.toLowerCase()} data-tags={`${work.tags.join(' ')} ${work.writtenForZtk===true?'for-ztk original':''}`}><span>{work.composer}</span><a href={path(hr?`/repertoar/${work.slug}/`:`/en/repertoire/${work.slug}/`)}><i>{work.title}</i><b>→</b></a></article>)}</div><p id="no-results" hidden class="empty-note">{hr?'Nema rezultata za odabrani upit.':'No works match this search.'}</p></div></section>
 <section class="section alt"><div class="container grid-2"><div class="section-head"><p class="eyebrow">Composed for ZTK</p><h2>{hr?'Pišete za tamburaški kvartet?':'Writing for tambura quartet?'}</h2><p class="lead">{hr?'Pošaljite nam svoje djelo. Bez prijenosa datoteka — dovoljan je siguran link.':'Send us your work. No file uploads — a secure link is enough.'}</p></div><SubmissionForm {lang}/></div></section>
</BaseLayout>
<script>
 const input=document.querySelector<HTMLInputElement>('#work-search');const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];const items=[...document.querySelectorAll<HTMLElement>('#work-list article')];const empty=document.querySelector<HTMLElement>('#no-results');let active='all';
 const update=()=>{const query=(input?.value||'').toLowerCase().trim();let shown=0;items.forEach(item=>{const matchesText=!query||item.dataset.text?.includes(query);const matchesFilter=active==='all'||item.dataset.tags?.split(' ').includes(active);const visible=!!matchesText&&!!matchesFilter;item.hidden=!visible;if(visible)shown++});if(empty)empty.hidden=shown>0};
 input?.addEventListener('input',update);buttons.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.filter||'all';buttons.forEach(b=>b.classList.toggle('active',b===button));update()}));
</script>
<style>.explorer{display:grid;gap:30px}.search{display:grid;gap:8px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.search input{width:100%;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white;padding:1.3rem 1.4rem;color:var(--color-text);font-size:1.1rem;box-shadow:var(--shadow-soft)}.filters{display:flex;flex-wrap:wrap;gap:10px}.filters button{min-height:44px;border:1px solid var(--color-line);border-radius:999px;padding:.65rem .9rem;background:white;color:var(--color-text);font-weight:700;cursor:pointer}.filters button.active,.filters button:hover{background:var(--color-copper);color:white;border-color:var(--color-copper)}.work-list{border-top:1px solid var(--color-line)}.work-list article{display:grid;grid-template-columns:.7fr 1.3fr;gap:24px;padding:20px 8px;border-bottom:1px solid var(--color-line)}.work-list article[hidden]{display:none}.work-list span{font-size:.82rem;text-transform:uppercase;letter-spacing:.06em}.work-list a{display:flex;justify-content:space-between;text-decoration:none;font:500 1.45rem var(--serif)}.work-list b{color:var(--color-copper);transition:transform .2s}.work-list a:hover b{transform:translateX(5px)}@media(max-width:600px){.work-list article{grid-template-columns:1fr;gap:4px}.work-list a{font-size:1.3rem}}</style>
