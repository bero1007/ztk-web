---
import type { EventItem,Lang } from '@/data/content';
import type { PerformancePlace } from '@/data/places';
import {path,formatDate} from '@/lib/i18n';
const {events,lang,places=[]}=Astro.props as {events:EventItem[];lang:Lang;places?:PerformancePlace[]};
const hr=lang==='hr';
const points=new Map<string,{city:string;lat:number;lng:number;entries:{title:string;date:string;venue:string;href:string}[]}>();
for(const p of places.filter(p=>p.published))points.set(p.city,{city:p.city,lat:p.latitude,lng:p.longitude,entries:[]});
for(const e of events.filter(e=>e.published)){
 const known=points.get(e.city),lat=e.latitude??known?.lat,lng=e.longitude??known?.lng;if(lat==null||lng==null)continue;
 const key=e.latitude!=null?e.latitude+','+e.longitude:e.city;
 const point=points.get(key)||{city:e.city,lat,lng,entries:[]};
 point.entries.push({title:hr?e.titleHr:e.titleEn,date:formatDate(e.date,lang),venue:e.venue,href:path(hr?`/dogadjaji/${e.slug}/`:`/en/events/${e.slug}/`)});
 points.set(key,point);
}
const items=[...points.values()];
---
{items.length>0&&<div class="map-shell" data-map-shell data-points={JSON.stringify(items)} data-lang={lang}>
 <div class="map-consent"><p>{hr?'Istražite koncertna odredišta kvarteta. Učitavanjem karte povezujete se s uslugom OpenStreetMap.':'Explore the quartet’s concert destinations. Loading the map connects to OpenStreetMap.'}</p><button class="button outline" data-load-map>{hr?'Učitaj kartu':'Load map'} →</button></div>
 <div class="map-ranges" hidden><button type="button" class="button outline" data-map-region="local">{hr?'Hrvatska i okolica':'Croatia and nearby'}</button><button type="button" class="button outline" data-map-region="world">{hr?'Sva odredišta':'All destinations'}</button></div>
 <div class="events-map" hidden aria-label={hr?'Karta koncertnih odredišta':'Map of concert destinations'}></div>
 <p class="map-note">{hr?'Oznake gradova prikazuju približan položaj, a ne nužno koncertnu dvoranu.':'City markers show approximate locations, not necessarily the concert venue.'}</p>
 <details><summary>{hr?'Popis mjesta':'List of destinations'} ({new Set(items.map(i=>i.city)).size})</summary><p>{[...new Set(items.map(i=>i.city))].sort().join(' · ')}</p></details>
</div>}
<script>
 import 'leaflet/dist/leaflet.css';
 document.querySelectorAll<HTMLElement>('[data-map-shell]').forEach(shell=>{
 const button=shell.querySelector<HTMLButtonElement>('[data-load-map]')!;
 button.addEventListener('click',async()=>{
 button.disabled=true;
 try{
 const L=await import('leaflet');
 const el=shell.querySelector<HTMLElement>('.events-map')!;el.hidden=false;
 const points=JSON.parse(shell.dataset.points||'[]') as {city:string;lat:number;lng:number;entries:{title:string;date:string;venue:string;href:string}[]}[];
 const map=L.map(el,{scrollWheelZoom:false});
 L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',maxZoom:19}).addTo(map);
 const icon=L.divIcon({className:'ztk-marker',html:'<span></span>',iconSize:[28,28],iconAnchor:[14,14]});
 points.forEach(point=>{
 const popup=document.createElement('div');const heading=document.createElement('strong');heading.textContent=point.city;popup.append(heading);
 point.entries.forEach(entry=>{const p=document.createElement('p');const a=document.createElement('a');a.href=entry.href;a.textContent=entry.title;const meta=document.createElement('small');meta.textContent=[entry.date,entry.venue].filter(Boolean).join(' · ');p.append(a,document.createElement('br'),meta);popup.append(p)});
 const marker=L.marker([point.lat,point.lng],{icon,title:point.city}).addTo(map).bindPopup(popup);marker.getElement()?.setAttribute('aria-label',point.city);
 });
 const fit=(region:string)=>{const local=points.filter(p=>p.lat>42&&p.lat<47&&p.lng>13&&p.lng<20);const selected=region==='local'&&local.length?local:points;map.fitBounds(selected.map(p=>[p.lat,p.lng] as [number,number]),{padding:[35,35],maxZoom:14});};
 fit('local');
 shell.querySelector<HTMLElement>('.map-ranges')!.hidden=false;
 shell.querySelectorAll<HTMLButtonElement>('[data-map-region]').forEach(control=>control.addEventListener('click',()=>fit(control.dataset.mapRegion!)));
 shell.querySelector<HTMLElement>('.map-consent')!.hidden=true;requestAnimationFrame(()=>map.invalidateSize());
 }catch{button.disabled=false;button.textContent=shell.dataset.lang==='hr'?'Pokušajte ponovno':'Try again';}
 });
 });
</script>
<style>
 .map-ranges{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
 .map-shell{background:var(--color-surface-alt);padding:20px}
 .map-consent{padding:40px 10px;max-width:640px;margin:auto;text-align:center;display:grid;gap:20px;justify-items:center}
 .events-map{height:440px;background:var(--color-blue-100)}
 .map-note,details{font-size:.8rem;margin:16px 0 0;color:var(--color-muted)}
 summary{cursor:pointer;min-height:44px;align-content:center}
 :global(.ztk-marker span){display:block;width:24px;height:24px;border:5px solid var(--color-navy-900);border-radius:50%;background:var(--color-copper)}
 :global(.leaflet-popup-content-wrapper){color:var(--color-text);font-family:var(--sans)}
 :global(.leaflet-popup-content){max-height:260px;overflow-y:auto}
 :global(.leaflet-popup-content a){color:var(--color-text);font-weight:700}
</style>
