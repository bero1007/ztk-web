---
import type { Lang } from '@/data/content';
import { labels, routes, path } from '@/lib/i18n';
interface Props { lang: Lang; alternatePath: string }
const { lang, alternatePath } = Astro.props;
const r = routes(lang);
const l = labels[lang];
const nav = [['home', l.home], ['quartet', l.quartet], ['programmes', l.programmes], ['events', l.events], ['repertoire', l.repertoire], ['media', l.media], ['booking', l.booking]] as const;
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={path(r.home)} aria-label={lang === 'hr' ? 'Zagrebački tamburaški kvartet — početna' : 'Zagreb Tambura Quartet — home'}>
      <span class="brand-mark" aria-hidden="true">Z</span>
      <span><strong>{lang === 'hr' ? 'Zagrebački tamburaški kvartet' : 'Zagreb Tambura Quartet'}</strong><small>official site prototype</small></span>
    </a>
    <nav id="main-nav" aria-label={lang === 'hr' ? 'Glavna navigacija' : 'Main navigation'}>
      {nav.map(([key, label]) => <a href={path(r[key])}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="language" href={path(alternatePath)} lang={lang === 'hr' ? 'en' : 'hr'}>{lang === 'hr' ? 'EN' : 'HR'}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">{lang === 'hr' ? 'Otvori izbornik' : 'Open menu'}</b></button>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }));
</script>
<style>
  .site-header { position: absolute; inset: 0 0 auto; z-index: 20; color: white; border-bottom: 1px solid rgba(255,255,255,.11); }
  .header-inner { width: min(calc(100% - 40px), var(--content-width)); margin: auto; min-height: 92px; display: flex; align-items: center; gap: 30px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .brand-mark { width: 38px; height: 46px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.65); border-radius: 50% 50% 8px 8px; font-family: var(--serif); font-size: 1.5rem; }
  .brand strong { display: block; font-family: var(--serif); font-size: 1.05rem; line-height: 1.1; }
  .brand small { display: block; color: #b8c7d9; font-size: .58rem; letter-spacing: .11em; text-transform: uppercase; }
  nav { display: flex; align-items: center; gap: clamp(14px, 2vw, 28px); }
  nav a, .language { position: relative; color: inherit; font-size: .72rem; font-weight: 700; letter-spacing: .065em; text-decoration: none; text-transform: uppercase; }
  nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -8px; height: 2px; background: var(--color-copper); transition: right .2s ease; }
  nav a:hover::after { right: 0; }
  .header-actions { display: flex; align-items: center; gap: 16px; }
  .language { border: 1px solid rgba(255,255,255,.35); padding: .5rem .65rem; border-radius: 999px; }
  .menu-toggle { display: none; width: 46px; height: 46px; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: transparent; padding: 12px; }
  .menu-toggle span { display: block; height: 1px; margin: 5px 0; background: white; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 1040px) {
    .menu-toggle { display: block; }
    nav { position: absolute; left: 0; right: 0; top: 92px; display: none; padding: 24px 20px 30px; background: var(--color-navy-900); border-top: 1px solid rgba(255,255,255,.1); flex-direction: column; align-items: stretch; }
    nav.open { display: flex; }
    nav a { min-height: 44px; display: flex; align-items: center; font-family: var(--serif); font-size: 1.55rem; text-transform: none; }
  }
  @media (max-width: 560px) {
    .header-inner { width: calc(100% - 28px); min-height: 82px; }
    nav { top: 82px; }
    .brand strong { font-size: .88rem; max-width: 170px; }
    .brand small { display: none; }
    .brand-mark { width: 34px; height: 40px; }
  }
</style>
